# ─── AutoFix AI agent ─────────────────────────────────────────────────────────
AI_PROVIDER=mock              # mock | claude   (mock = deterministic offline fixes)
DRY_RUN=true                  # true = simulate Trello + GitHub; false = real PRs

PORT=4000                     # dashboard port
APP_PATH=../checkout-service  # the target repo the agent fixes
E2E_PATH=../checkout-e2e      # the black-box suite the agent runs to detect/validate
APP_PORT=3100                 # port the app-under-test is started on

# Anthropic — only used when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Trello — only used when DRY_RUN=false
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
TRELLO_WEBHOOK_SECRET=

# GitHub — only used when DRY_RUN=false
GITHUB_TOKEN=
GITHUB_OWNER=PiyushSinghal-QA
GITHUB_REPO=checkout-service
GITHUB_DEFAULT_REVIEWER=
